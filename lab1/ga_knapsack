import random

n = int(input("Number of items: "))
pop_size = int(input("Population size: "))
cr = float(input("Crossover rate: "))
mr = float(input("Mutation rate: "))

weights = list(map(int, input("Weights: ").split()))
values = list(map(int, input("Values: ").split()))
capacity = int(input("Knapsack capacity: "))

pop = []
for i in range(pop_size):
    pop.append(list(map(int, input("Chromosome: ").split())))

def fitness(ch):
    w = v = 0
    for i in range(n):
        if ch[i]:
            w += weights[i]
            v += values[i]
    return v if w <= capacity else 0

for ch in pop:
    print(ch, "Fitness =", fitness(ch))

fit = [fitness(ch) for ch in pop]
selected = random.choices(pop, weights=fit, k=pop_size)

new = []
for i in range(0, pop_size, 2):
    p1, p2 = selected[i], selected[i+1]

    if random.random() < cr:
        point = random.randint(1, n-1)
        c1 = p1[:point] + p2[point:]
        c2 = p2[:point] + p1[point:]
    else:
        c1, c2 = p1[:], p2[:]

    new += [c1, c2]

for ch in new:
    for i in range(n):
        if random.random() < mr:
            ch[i] = 1 - ch[i]

best = max(new, key=fitness)

print("\nNew Population:")
for ch in new:
    print(ch, "Fitness =", fitness(ch))

print("\nBest chromosome:", best)
print("Best fitness:", fitness(best))
